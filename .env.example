# Copy to .env and fill in. Everything has a working default except the API key.
# .env is gitignored; this file is committed, so never put a real key here.

# Optional: Google AI Studio key for Gemini (fallback only)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Agent mode: live | scripted
# live = use Ollama (local) or Gemini (if key set)
# scripted = deterministic tool calls without any LLM
AGENT_MODE=live

# Ollama (local model) - PRIMARY LLM
# Run: ollama serve && ollama pull gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# SQLite persistence
SQLITE_PATH=/data/chokepoint.db

# Graphify integration (optional)
# Get from https://github.com/Graphify-Labs/graphify
GRAPHIFY_PATH=graphify
GRAPHIFY_WORKSPACE=/data/graphify-workspaces

# Directory that /api/codebases/scan-directory and scan-manual are confined to.
# Place repositories or .zip archives here; paths outside it are rejected.
CODEBASES_DIR=/data/codebases

# MCP server
MCP_URL=http://mcp:8765/mcp

# Embeddings
EMBEDDINGS=fastembed           # fastembed | none
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Repository ingestion
MAX_REPO_SIZE_MB=500
MAX_EXTRACT_TIME_S=300

# Scanner configuration
TRIVY_PATH=trivy
SEMGREP_PATH=semgrep
SCANNER_TIMEOUT_S=300

# Port configuration
BACKEND_PORT=8050

# Seed / outbox
SEED_SCALE=1
OUTBOX_DIR=/data/outbox

# Optional delivery targets for approved actions. Unset means local outbox only.
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173